                    "editorMode": "code",
                    "format": "table",
                    "rawQuery": true,
                    "rawSql": "SELECT\n   COALESCE(CAST(tt.created_at AS TEXT), '_') AS created_at,\n   TO_CHAR(CAST(r.amount AS real) / 100000000.0, 'FM999999999.00000000') || ' BTC' AS amount,\n   COALESCE(p.addr, '_') AS pegout_addr,\n   COALESCE(p.bitcoin_tx_id, '_') AS bitcoin_tx_id,\n   COALESCE(tt.hash, '_') AS ton_tx,\n   COALESCE(p.status, '_') AS pegout_status\nFROM reinits AS r\nLEFT JOIN ton_txes AS tt ON tt.id = r.ton_tx_reinit\nLEFT JOIN pegouts AS p ON p.id = r.pegout_reinit\nORDER BY r.id DESC\nLIMIT ${page_size}\nOFFSET ${page_size}*${page_id}\n",
