                    "editorMode": "code",
                    "format": "table",
                    "rawQuery": true,
                    "rawSql": "SELECT\nM.CREATED_AT,\nM.STATUS,\nCAST(M.AMOUNT as REAL) / 100000000.0 AS AMOUNT,\nCOALESCE(TT.HASH, '_') AS TON_TX,\nP.RECEIVER_ADDR,\nP.BITCOIN_TX_ID\nFROM MINTS AS M\nLEFT JOIN TON_TXES AS TT ON M.TON_TX_MINT = TT.ID\nLEFT JOIN PEGINS AS P ON M.ID = P.MINT_PEGIN\nORDER BY M.ID DESC\nLIMIT ${page_size}\nOFFSET ${page_size}*${page_id};\n",
