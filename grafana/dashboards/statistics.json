                    "hide": false,
                    "rawQuery": true,
                    "rawSql": "WITH date_series AS (\n  SELECT generate_series(\n    DATE_TRUNC('day', $__timeFrom()::timestamp),\n    DATE_TRUNC('day', $__timeTo()::timestamp),\n    '1 day'::interval\n  ) AS day\n),\ndaily_counts AS (\n  SELECT\n    DATE_TRUNC('day', created_at) AS day,\n    COUNT(*) AS count\n  FROM burns as b\n  join ton_txes as tt on tt.id = ton_tx_burn\n  join pegouts as p on p.id = b.pegout_burn\n  WHERE $__timeFilter(created_at) and p.status = 'CONFIRMED'\n  GROUP BY 1\n)\nSELECT\n  ds.day AS time,\n  COALESCE(dc.count, 0) AS \"Burns\"\nFROM date_series ds\nLEFT JOIN daily_counts dc ON ds.day = dc.day\nORDER BY 1;",
