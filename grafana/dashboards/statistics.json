                    "editorMode": "code",
                    "format": "table",
                    "rawQuery": true,
                    "rawSql": "WITH date_series AS (\n  SELECT generate_series(\n    DATE_TRUNC('day', $__timeFrom()::timestamp),\n    DATE_TRUNC('day', $__timeTo()::timestamp),\n    '1 day'::interval\n  ) AS day\n),\ndaily_counts AS (\n  SELECT\n    DATE_TRUNC('day', created_at) AS day,\n    COUNT(*) AS count\n  FROM mints\n  WHERE $__timeFilter(created_at) AND status = 'SUCCESS'\n  GROUP BY 1\n)\nSELECT\n  ds.day AS time,\n  COALESCE(dc.count, 0) AS \"Mints\"\nFROM date_series ds\nLEFT JOIN daily_counts dc ON ds.day = dc.day\nORDER BY 1;",
                    "refId": "A",
                    "sql": {
                        "columns": [
